class Solution {
public:
    int countGoodRectangles(vector<vector<int>>& rectangles) {
        int maxSquare = 0;
        int count = 0;

        for (auto r : rectangles) {
            int side = min(r[0], r[1]);

            if (side > maxSquare) {
                maxSquare = side;
                count = 1;
            }
            else if (side == maxSquare) {
                count++;
            }
        }

        return count;
    }
};
